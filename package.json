{
  "name": "herdr-workflow-watch",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub workflow failure indicators for Herdr workspaces",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "effect-tsgo patch --force=false"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.118",
    "@timmo001/effect-gh": "0.2.0",
    "@timmo001/effect-herdr": "0.8.2-timmo001.2",
    "effect": "4.0.0-rc.118",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.47.0",
    "@oxlint/plugins": "1.86.0",
    "@timmo001/oxlint-rules": "0.4.0",
    "@types/bun": "1.4.2",
    "@types/proper-lockfile": "4.1.4",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "overrides": {
    "effect": "$effect",
    "@effect/platform-node-shared": "$@effect/platform-node"
  },
  "trustedDependencies": [
    "@effect/tsgo"
  ]
}
