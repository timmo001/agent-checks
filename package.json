{
  "name": "agent-checks",
  "version": "0.1.0",
  "private": true,
  "description": "CI and lint status for Herdr workspaces, with an Omarchy panel",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "effect-tsgo patch --force=false"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.0",
    "@timmo001/effect-gh": "0.9.1",
    "@timmo001/effect-herdr": "0.9.0-timmo001.4",
    "effect": "4.1.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@oxlint/plugins": "1.90.0",
    "@timmo001/oxlint-rules": "0.6.3",
    "@types/bun": "1.4.4",
    "@types/proper-lockfile": "4.1.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "effect": "$effect",
    "@effect/platform-node-shared": "$@effect/platform-node"
  },
  "trustedDependencies": [
    "@effect/tsgo"
  ]
}
